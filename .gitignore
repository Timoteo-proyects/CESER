
# ==========================================
# DEPENDENCIAS
# ==========================================
node_modules/
frontend/node_modules/
backend/node_modules/

# ==========================================
# VARIABLES DE ENTORNO Y SECRETOS
# ==========================================
.env
.env.*
!.env.example

# Certificados y claves privadas
*.pem
*.key
*.p12
*.pfx

# ==========================================
# ARCHIVOS GENERADOS
# ==========================================
frontend/dist/
frontend/build/
backend/dist/
backend/build/
coverage/

# ==========================================
# LOGS
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# ARCHIVOS TEMPORALES DEL SISTEMA
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# CONFIGURACIONES LOCALES DE EDITORES
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ==========================================
# ARCHIVOS DE PYTHON TEMPORALES
# (si usaste scripts para migrar los DBF)
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/